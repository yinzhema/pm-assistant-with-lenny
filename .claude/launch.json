{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pm-assistant-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "pm-assistant-backend",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["main:app", "--reload", "--port", "8080"],
      "port": 8080,
      "cwd": "backend"
    }
  ]
}
