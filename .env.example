# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Pinecone (vector database)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=pm-assistant

# Optional: Customize model settings
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Multi-LLM tiering
# FRONTIER_MODEL: used for complex tasks (artifact synthesis, PRD translation, gap analysis)
# EFFICIENT_MODEL: used for real-time tasks (per-answer preview, clarifying Q&A)
FRONTIER_MODEL=gpt-4.1
EFFICIENT_MODEL=gpt-4o-mini